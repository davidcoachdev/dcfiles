# .dcfilesignore — paths dcfiles must never import into config/
#
# Syntax:
#   name/      bare directory name — pruned at any depth
#   a/b/       anchored directory  — pruned at that path only
#   *.ext      glob matched against the basename
#   a/b/*.ext  glob containing "/" — matched against the path relative to $HOME
#   # comment  ignored
#
# Applies to `dcfiles add <dir>` and `dcfiles sync --import`.
# Files already present in config/ are unaffected.

# ---------------------------------------------------------------------------
# Dependency + VCS trees
# ---------------------------------------------------------------------------
node_modules/
.git/
.svn/
.hg/
vendor/
bower_components/
.pnpm-store/

# ---------------------------------------------------------------------------
# Python / build artefacts
# ---------------------------------------------------------------------------
__pycache__/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
dist/
build/
target/
.next/
.turbo/

